{
 "_doc": "How people respond to what happens around them. 'on' maps a game happening (sent by the rules through sim.react.trigger) to a list of responses, run in order. Each response has a verb in 'do' (cover, aid, flee, firefight, defend: what the person does, coded in reactions.gd) and the numbers and texts for it. 'who' picks the people: all (everyone in the village), able (grown-ups fit to help: see 'able'), victim (the one it happened to), near (within 'reach' of the place), river (within 'reach' of a river), helpers (the nearest able people within 'reach' of the victim, at most 'count'; friends and kin of the victim come from 'bond_reach' further, and first), exposed (out in the open, away from any warmth: a blizzard sends them in). warm: below/until (shares of max HP), while_weather (stay by the warmth while that weather lasts). look and startle only run while everyday life is on (config/life.json). 'talk' (any response) names a situation of life.json's talk lines, said with talk_chance when the response starts ('talk_force': even past the usual limits, for a panic); 'pose' is the drawn pose once there (cover). 'roles' limits who it applies to ('' = an ordinary villager). Texts are English translation keys. See docs/CONFIG.md.",

 "able": {
  "min_hp": 0.5,
  "busy": ["attack", "bury", "explore", "trade_trip", "aid", "firefight", "cover", "warm", "shelter"]
 },

 "night_watch": {
  "_doc": "What rouses the sleeping camp: beasts or raiders this close to the village, someone hit in a fight in the last hit_recent seconds, a flood in the last flood_recent seconds, or a force of nature (nature.alarm). The alarm lasts alarm seconds; people sleeping outdoors also wake for beasts within outdoor_beasts.",
  "beasts_at_village": 500, "hit_recent": 4, "flood_recent": 20, "alarm": 6, "outdoor_beasts": 300
 },

 "on": {
  "earthquake": [
   {"do": "cover", "who": "all", "skip_roles": ["contract", "envoy", "trader"], "skip_jobs": ["attack"],
    "wake": true, "clear": 110, "max_move": 160, "time": 7, "until_shake": 0.3,
    "then": "hurt", "then_below": 0.8, "then_reach": 320, "pose": "sit",
    "talk": "quake", "talk_chance": 0.7, "talk_force": true,
    "acts": ["Running into the open", "Crouching in the open"]}
  ],

  "hurt": [
   {"do": "aid", "who": "helpers", "count": 2, "reach": 320, "bond_reach": 200, "below": 0.9, "time": 5, "heal": 0.2, "xp": {"lore": 3},
    "popup": "Runs to help %s", "remember": "was tended by %s after being hurt on Day %d",
    "acts": ["Running to help %s", "Tending %s"]}
  ],

  "burned": [
   {"do": "flee", "who": "victim", "roles": ["", "child"], "dist": 260}
  ],

  "attacked": [
   {"do": "defend", "who": "helpers", "count": 3, "reach": 260, "bond_reach": 180,
    "reach_by_trait": {"belligerent": 340, "lazy": 180}, "skip_attackers": ["hunter", "trader"],
    "popup": "To %s's aid!"}
  ],

  "hunt_help": [
   {"do": "defend", "who": "helpers", "count": 3, "reach": 340, "bond_reach": 240,
    "reach_by_trait": {"belligerent": 420, "lazy": 220}, "skip_attackers": ["hunter", "trader"],
    "popup": "To %s's aid!"}
  ],

  "flood_warning": [
   {"do": "flee", "who": "river", "reach": 240, "dist": 380, "skip_jobs": ["attack"], "resume": false}
  ],

  "volcano_tremor": [
   {"do": "flee", "who": "near", "reach": 828, "beyond": 200}
  ],

  "eruption": [
   {"do": "flee", "who": "near", "reach": 736, "beyond": 200}
  ],

  "wildfire": [
   {"do": "firefight", "who": "able", "count": 6, "reach": 420, "near_home": 700, "near_building": 200,
    "stand_off": 62, "rate": 1.6, "xp": {"combat": 1}, "give_up": 630,
    "popup": "Fights the fire!", "out_popup": "Put out!", "log": "The fire is beaten out. The tribe saved what it could.",
    "acts": ["Running to the fire", "Beating out the flames"]},
   {"do": "flee", "who": "near", "reach": 120, "dist": 260}
  ],

  "freezing": [
   {"do": "warm", "who": "victim", "below": 0.55, "until": 0.8, "popup": "Seeking warmth",
    "acts": ["Seeking warmth", "Warming by the fire"]}
  ],

  "beast_seen": [
   {"do": "flee", "who": "victim", "reach": 240, "dist": 260, "popup": "Beast! Scout backs off"}
  ],

  "panic": [
   {"do": "shelter", "who": "all", "skip_roles": ["contract", "envoy", "trader"], "skip_jobs": ["attack", "bury"],
    "talk": "panic", "talk_chance": 0.6, "talk_force": true,
    "acts": ["Running to hide", "Hiding in a hut", "Cowering in fear"]}
  ],

  "built": [
   {"do": "look", "who": "near", "reach": 420, "count": 5, "chance": 0.7, "ring": [45, 80], "time": [4, 7],
    "acts": ["Going to see the new building", "Admiring the new building"], "talk": "built", "talk_chance": 0.5}
  ],

  "masterpiece": [
   {"do": "look", "who": "near", "reach": 500, "count": 6, "chance": 0.8, "ring": [30, 55], "time": [4, 7],
    "acts": ["Going to see the masterpiece", "Admiring the masterpiece"], "talk": "built", "talk_chance": 0.5}
  ],

  "birth": [
   {"do": "look", "who": "near", "reach": 420, "count": 6, "chance": 0.8, "ring": [30, 60], "time": [5, 8],
    "acts": ["Going to see the newborn", "Welcoming the newborn"], "talk": "birth", "talk_chance": 0.5}
  ],

  "visitor": [
   {"do": "look", "who": "near", "reach": 500, "count": 5, "chance": 0.6, "ring": [60, 100], "time": [6, 10],
    "acts": ["Going to see the strangers", "Watching the strangers"], "talk": "visitor", "talk_chance": 0.5}
  ],

  "beast_slain": [
   {"do": "look", "who": "near", "reach": 500, "count": 5, "chance": 0.8, "ring": [35, 60], "time": [4, 7],
    "acts": ["Running to see the kill", "Cheering the hunter"], "talk": "cheer", "talk_chance": 0.6}
  ],

  "thunder": [
   {"do": "startle", "who": "near", "reach": 900, "skip_roles": ["envoy", "trader"], "time": [1.2, 2.2],
    "acts": ["Startled by thunder"], "talk": "startled", "talk_chance": 0.3}
  ],

  "blizzard": [
   {"do": "warm", "who": "exposed", "roles": [""], "skip_jobs": ["attack", "bury", "aid", "firefight"], "below": 1.01, "until": 1.01, "while_weather": "blizzard", "popup": "Heads in from the blizzard",
    "acts": ["Heading in from the blizzard", "Sheltering from the blizzard"]}
  ],
  "storm": [],
  "rain": [],
  "drought": [],
  "sickness": [],
  "famine": []
 }
}
